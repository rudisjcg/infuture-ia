# Copy to .env and adjust / Copia a .env y ajusta

# API
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Default language when the client sends none / Idioma por defecto si el cliente no envía ninguno (en | es)
DEFAULT_LOCALE=en

# Database / Base de datos (docker compose up -d)
DATABASE_URL=postgres://infuture:infuture@localhost:5432/infuture

# Redis
REDIS_URL=redis://localhost:6379

# Master key that encrypts provider credentials. Generate one with: pnpm vault:key
# Clave maestra que cifra las credenciales. Genérala con: pnpm vault:key
INFUTURE_MASTER_KEY=

# Admin/service bearer token: works on every /api/v1 route and is required for custom code tools if API_HOST is not loopback.
# Token para herramientas de código personalizadas. Obligatorio si API_HOST no es loopback.
API_TOKEN=

# Authentication / Autenticación
# The first sign-up becomes the workspace owner; later sign-ups need AUTH_SIGNUP_OPEN=true.
# El primer registro es el propietario; los siguientes requieren AUTH_SIGNUP_OPEN=true.
AUTH_SIGNUP_OPEN=false
# Session lifetime in hours / Duración de la sesión en horas
AUTH_SESSION_TTL_HOURS=168
# Secure cookie (HTTPS only). Defaults to true when NODE_ENV=production.
# AUTH_COOKIE_SECURE=true
